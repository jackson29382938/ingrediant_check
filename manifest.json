    "*://*.amazon.com.br/*",
    "*://*.amazon.co.jp/*"
  ],
  "optional_permissions": [
    "identity"
  ],
  "optional_host_permissions": [
    "https://world.openfoodfacts.org/*"
  ],
  "commands": {
    "sort-health": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "__MSG_cmdSortHealth__"
    },
    "sort-price": {
      "description": "__MSG_cmdSortPrice__"
    }
  },
  "action": {
    "default_popup": "src/options/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
