  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "unlimitedStorage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
