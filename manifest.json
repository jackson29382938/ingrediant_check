{
  "manifest_version": 3,
  "name": "Ingredient Check",
  "version": "0.9.0",
  "description": "Rates grocery products 0\u2013100 on ingredients, additives and processing. You set every weight. Scoring runs on your computer.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://world.openfoodfacts.org/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "src/options/popup.html",
    "default_title": "Ingredient Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/engine/db/_module.js",
        "src/engine/db/oils.js",
        "src/engine/db/sugars.js",
        "src/engine/db/additives.js",
        "src/engine/db/labels.js",
        "src/engine/db/allergens.js",
        "src/engine/db/ingestible.js",
        "src/engine/db/provenance.js",
        "src/engine/categories.js",
        "src/engine/score.js",
        "src/content/extract.js",
        "src/content/panel.js",
        "src/content/main.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}