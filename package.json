{
  "name": "ingredient-check",
  "private": true,
  "description": "Local Chrome session for Ingredient Check (unpacked MV3).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "chrome": "node scripts/dev-chrome.mjs",
    "chrome:reload": "node scripts/reload-extension.mjs",
    "ab": "node scripts/ab.mjs",
    "browser:setup": "node scripts/setup-browser.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:serial": "node --test --test-concurrency=1 tests/*.test.js",
    "pack": "node scripts/pack.mjs",
    "harness": "node scripts/harness-server.mjs",
    "harness:ci": "node scripts/harness-ci.mjs",
    "preflight": "node scripts/preflight.mjs",
    "lint": "npm install --no-save --no-package-lock eslint@9.39.5 @eslint/js@9.39.5 globals@17.12.0 && ./node_modules/.bin/eslint --max-warnings 0 .",
    "live-check": "node scripts/live-check.mjs",
    "pack:chrome": "node scripts/pack.mjs chrome",
    "pack:firefox": "node scripts/pack.mjs firefox",
    "firefox:setup": "node scripts/setup-firefox.mjs",
    "firefox:lint": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "harness:firefox": "node scripts/firefox-harness.mjs",
    "website:check": "node scripts/website-check.mjs"
  }
}
