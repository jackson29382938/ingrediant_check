{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/ensure-chrome.sh",
        "timeout": 20
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/reload-extension.sh",
        "timeout": 15
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/reload-extension.sh",
        "timeout": 15
      }
    ]
  }
}
